{
  "name": "instavault",
  "productName": "InstaVault",
  "private": true,
  "version": "2.0.0",
  "description": "Archivo privado de perfiles de Instagram: biblioteca local, descargas en máxima calidad y descarga por enlace.",
  "author": "Xainner",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
