{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstaVault",
  "version": "1.0.0",
  "identifier": "com.xainner.instavault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InstaVault — Instagram Downloader",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREMEExRjA2OEQyQUVENgpSV1RXcnRKbzhLSFFEV0RCVSs2RG94OUNaUXRtbkZpZGFRcUp0ZGVwVjI1M3NqRk5PWG4zTXVYSgo=",
      "endpoints": [
        "https://github.com/Xainner/instavault/releases/latest/download/latest.json"
      ]
    }
  }
}
